{
  "framework": null,
  "buildCommand": "mkdir -p public && cp install.sh public/install.sh",
  "installCommand": "echo 'No install required for Vercel static hosting'",
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.sh"
    }
  ],
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}
